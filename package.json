{
  "name": "forgeq",
  "displayName": "ForgeQ",
  "description": "在 VS Code 里导入、练习和复习自己的题库",
  "version": "0.0.8",
  "publisher": "Jett191",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Jett191/ForgeQ.git"
  },
  "homepage": "https://github.com/Jett191/ForgeQ#readme",
  "bugs": {
    "url": "https://github.com/Jett191/ForgeQ/issues"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=18"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "keywords": [
    "study",
    "quiz",
    "question-bank",
    "interview",
    "practice",
    "questions",
    "review"
  ],
  "icon": "media/icon.png",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:frontendInterview.questionList",
    "onView:frontendInterview.review",
    "onCommand:frontendInterview.import",
    "onCommand:frontendInterview.openQuestion",
    "onCommand:frontendInterview.deleteAnswer",
    "onCommand:frontendInterview.switchBank",
    "onCommand:frontendInterview.removeBank",
    "onCommand:frontendInterview.review.unmastered",
    "onCommand:frontendInterview.review.favorite",
    "onCommand:frontendInterview.review.wrong",
    "onCommand:frontendInterview.filter.byType",
    "onCommand:frontendInterview.filter.byCategory",
    "onCommand:frontendInterview.filter.byDifficulty",
    "onCommand:frontendInterview.filter.clear",
    "onCommand:frontendInterview.toggleGroupByCategory"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "frontendInterview",
          "title": "ForgeQ",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "frontendInterview": [
        {
          "id": "frontendInterview.questionList",
          "name": "题目",
          "contextualTitle": "ForgeQ"
        },
        {
          "id": "frontendInterview.review",
          "name": "复习",
          "contextualTitle": "ForgeQ"
        }
      ]
    },
    "commands": [
      {
        "command": "frontendInterview.import",
        "title": "导入题库",
        "category": "ForgeQ",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "frontendInterview.openQuestion",
        "title": "打开题目",
        "category": "ForgeQ"
      },
      {
        "command": "frontendInterview.deleteAnswer",
        "title": "删除我的答案",
        "category": "ForgeQ",
        "icon": "$(trash)"
      },
      {
        "command": "frontendInterview.switchBank",
        "title": "切换题库",
        "category": "ForgeQ",
        "icon": "$(repo)"
      },
      {
        "command": "frontendInterview.removeBank",
        "title": "移除题库",
        "category": "ForgeQ",
        "icon": "$(trash)"
      },
      {
        "command": "frontendInterview.review.unmastered",
        "title": "复习未掌握",
        "category": "ForgeQ",
        "icon": "$(question)"
      },
      {
        "command": "frontendInterview.review.favorite",
        "title": "复习收藏",
        "category": "ForgeQ",
        "icon": "$(star-full)"
      },
      {
        "command": "frontendInterview.review.wrong",
        "title": "复习错题",
        "category": "ForgeQ",
        "icon": "$(error)"
      },
      {
        "command": "frontendInterview.filter.byType",
        "title": "筛选: 题型",
        "category": "ForgeQ",
        "icon": "$(symbol-class)"
      },
      {
        "command": "frontendInterview.filter.byCategory",
        "title": "筛选: 分类",
        "category": "ForgeQ",
        "icon": "$(folder-opened)"
      },
      {
        "command": "frontendInterview.filter.byDifficulty",
        "title": "筛选: 难度",
        "category": "ForgeQ",
        "icon": "$(flame)"
      },
      {
        "command": "frontendInterview.filter.clear",
        "title": "清除筛选",
        "category": "ForgeQ",
        "icon": "$(clear-all)"
      },
      {
        "command": "frontendInterview.toggleGroupByCategory",
        "title": "切换分类分组",
        "category": "ForgeQ",
        "icon": "$(group-by-ref-type)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "frontendInterview.import"
        },
        {
          "command": "frontendInterview.openQuestion",
          "when": "false"
        },
        {
          "command": "frontendInterview.deleteAnswer",
          "when": "false"
        },
        {
          "command": "frontendInterview.switchBank"
        },
        {
          "command": "frontendInterview.removeBank"
        },
        {
          "command": "frontendInterview.review.unmastered"
        },
        {
          "command": "frontendInterview.review.favorite"
        },
        {
          "command": "frontendInterview.review.wrong"
        },
        {
          "command": "frontendInterview.filter.byType"
        },
        {
          "command": "frontendInterview.filter.byCategory"
        },
        {
          "command": "frontendInterview.filter.byDifficulty"
        },
        {
          "command": "frontendInterview.filter.clear"
        },
        {
          "command": "frontendInterview.toggleGroupByCategory"
        }
      ],
      "view/item/context": [
        {
          "command": "frontendInterview.deleteAnswer",
          "when": "view == frontendInterview.questionList && viewItem == question",
          "group": "1_answer@1"
        },
        {
          "command": "frontendInterview.deleteAnswer",
          "when": "view == frontendInterview.review && viewItem == question",
          "group": "1_answer@1"
        }
      ],
      "view/title": [
        {
          "command": "frontendInterview.filter.byType",
          "when": "view == frontendInterview.questionList",
          "group": "navigation@1"
        },
        {
          "command": "frontendInterview.filter.byCategory",
          "when": "view == frontendInterview.questionList",
          "group": "navigation@2"
        },
        {
          "command": "frontendInterview.filter.byDifficulty",
          "when": "view == frontendInterview.questionList",
          "group": "navigation@3"
        },
        {
          "command": "frontendInterview.filter.clear",
          "when": "view == frontendInterview.questionList",
          "group": "navigation@4"
        },
        {
          "command": "frontendInterview.toggleGroupByCategory",
          "when": "view == frontendInterview.questionList",
          "group": "navigation@5"
        },
        {
          "command": "frontendInterview.import",
          "when": "view == frontendInterview.questionList",
          "group": "1_bank@1"
        },
        {
          "command": "frontendInterview.switchBank",
          "when": "view == frontendInterview.questionList",
          "group": "1_bank@2"
        },
        {
          "command": "frontendInterview.removeBank",
          "when": "view == frontendInterview.questionList",
          "group": "1_bank@3"
        },
        {
          "command": "frontendInterview.review.unmastered",
          "when": "view == frontendInterview.review",
          "group": "navigation@1"
        },
        {
          "command": "frontendInterview.review.favorite",
          "when": "view == frontendInterview.review",
          "group": "navigation@2"
        },
        {
          "command": "frontendInterview.review.wrong",
          "when": "view == frontendInterview.review",
          "group": "navigation@3"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "generate:schema": "node scripts/generateSchema.mjs",
    "check:schema": "node scripts/generateSchema.mjs --check",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:bench": "vitest bench --run --config vitest.config.ts",
    "test:integration": "node scripts/runIntegrationTests.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "katex": "^0.17.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/uuid": "^10.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "fast-check": "^3.23.0",
    "memfs": "^4.14.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
